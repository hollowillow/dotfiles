clearmaps

### KEYMAPS ###
map q quit
map <c-l> redraw
map . set hidden!

# operations
cmd rename ${{
        massren $fx
        lf -remote "send $id unselect"
}}
map yy copy
map dd cut
map p paste
map c clear
map r rename
map D delete

# search
map / search
map ? search-back
map n search-next
map N search-prev

# image manipulation
cmd rotate_image $magick $f -rotate 90 $f
cmd flip_image $magick $f -flip $f
cmd mirror_image $magick $f -flop $f
map ir rotate_image 
map if flip_image 
map im mirror_image

# SETTINGS
set autoquit false
set previewer previewer
set cleaner ~/.config/lf/cleaner
set relativenumber
set icons true
set ratios 1:2:3
set info size
set dircounts

### KEYBINDS
#### MOVEMENT
map h updir
map j down
map k up
map l open
map <c-u> half-up
map <c-d> half-down
map ] jump-next
map [ jump-prev
map gg top
map G bottom

#### SELECT
cmd toggle-all &{{
        for i in "$PWD"/*; do
                lf -remote "send $id toggle $i"
        done
}}
nmap <tab> :toggle; down
nmap <backtab> :toggle-all
nmap c clear unselect
map v visual-accept
map V visual
map o visual-change

#### STOW
cmd stow %{{
    for file in $fx; do
        package=$(basename $file)
        stow --stow $package
        printf "stowed $package"
    done
}}
map s :stow

cmd stow-delete %{{
    for file in $fx; do
        package=$(basename $file)
        stow --delete $package
        printf "deleted stowed $package"
    done
}}
map S :stow-delete

#### FZF
cmd fzf ${{
    res=$(fzf)
    [ -n "$res" ] && lf -remote "send $id select $PWD/$res"
}}
map f :fzf

#### WALLPAPERS
cmd wallpaper %{{
    wp set $f
    printf "set $f as wallpaper"
}}
nmap w :wallpaper

### FUNCTIONS
#### PIN CERTAIN FILES
set sortby custom
set reverse

cmd on-load &{{
    cmds=""
    for file in "$@"; do  
        # Get just the filename (basename)
        filename=$(basename "$file")

        # Assign custominfo based on filename
        case "$filename" in
            README.*|LICENSE.*|SCRATCH.*|CHANGELOG.*|TODO.*)
                cmds="${cmds}addcustominfo \"${file}\" \"0\"; "
                ;;
            flake.*)
                cmds="${cmds}addcustominfo \"${file}\" \"1\"; "
                ;;
            .gitignore|.envrc)
                cmds="${cmds}addcustominfo \"${file}\" \"2\"; "
                ;;
        esac
    done

    if [ -n "$cmds" ]; then
        lf -remote "send $id :$cmds"
    fi
}}

#### EXA INTEGRATION
cmd on-select &{{
    lf -remote "send $id set statfmt \"$(exa -ld --color=always "$f" | sed 's/\\/\\\\/g;s/"/\\"/g')\""
}}
set rulerfmt  "%a| %p| \033[7;31m %m \033[0m| \033[7;33m %c \033[0m| \033[7;35m %s \033[0m| \033[7;36m %v \033[0m|f=`%f',|  %i/%t"

### COMMANDS
#### FILE OPERATIONS
cmd open ${{
    for file in $fx; do
        case $(xdg-mime query filetype "$file") in
            text/*|application/json) $EDITOR "$file";;
            application/x-executable) "$file";;
            audio/*) setsid mpv --force-window=yes "$file" &disown;;
            video/*) setsid mpv "$file" & disown;;
            image/*) setsid mpv --keep-open=yes "$file" & disown;;
            *) xdg-open "$file" ;;
        esac
    done
}}

cmd mkdir %{{
    if [ -n "$1" ]; then
        ans="$1"
    else
        printf "Directory name: "
        read ans
    fi
    mkdir "$ans"
}}

cmd touch %{{
    if [ -n "$1" ]; then
        ans="$1"
    else
        printf "File name: "
        read ans
    fi
    touch "$ans"
}}

cmd chmod %{{
    if [ -n "$1" ]; then
        ans="$1"
    else
        printf "Mode Bits: "
        read ans
    fi

    for file in "$fx"
    do
        chmod $ans $file
    done

    lf -remote 'send reload'
}}

