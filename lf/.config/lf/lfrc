#### SELECT
cmd toggle-all &{{
        for i in "$PWD"/*; do
                lf -remote "send $id toggle $i"
        done
}}
nmap <tab> :toggle; down
nmap <backtab> :toggle-all
nmap c clear unselect
map v visual-accept
map V visual
map o visual-change

#### STOW
cmd stow %{{
    for file in $fx; do
        package=$(basename $file)
        stow --stow $package
        printf "stowed $package"
    done
}}
map s :stow

cmd stow-delete %{{
    for file in $fx; do
        package=$(basename $file)
        stow --delete $package
        printf "deleted stowed $package"
    done
}}
map S :stow-delete

#### FZF
cmd fzf ${{
    res=$(fzf)
    [ -n "$res" ] && lf -remote "send $id select $PWD/$res"
}}
map f :fzf

#### WALLPAPERS
cmd wallpaper %{{
    wp set $f
    printf "set $f as wallpaper"
}}
nmap w :wallpaper

### FUNCTIONS
#### PIN CERTAIN FILES
set sortby custom
set reverse

cmd on-load &{{
    cmds=""
    for file in "$@"; do  
        # Get just the filename (basename)
        filename=$(basename "$file")

        # Assign custominfo based on filename
        case "$filename" in
            README.*|LICENSE.*|SCRATCH.*|CHANGELOG.*|TODO.*)
                cmds="${cmds}addcustominfo \"${file}\" \"0\"; "
                ;;
            flake.*)
                cmds="${cmds}addcustominfo \"${file}\" \"1\"; "
                ;;
            .gitignore|.envrc)
                cmds="${cmds}addcustominfo \"${file}\" \"2\"; "
                ;;
        esac
    done

    if [ -n "$cmds" ]; then
        lf -remote "send $id :$cmds"
    fi
}}

#### EXA INTEGRATION
