set rulerfmt  "%a| %p| \033[7;31m %m \033[0m| \033[7;33m %c \033[0m| \033[7;35m %s \033[0m| \033[7;36m %v \033[0m|f=`%f',|  %i/%t"

### COMMANDS
set filesep ":"
cmd open ${{
    IFS=':'
    files=$(file --mime-type $fx | awk -F':[[:space:]]+' '{print $2, $1}')

    IFS=$'\n'
    for file in $files; do
        case $file in
            text/* | inode/x-empty*) filename=${file#* } ; text+="${filename}:" ;;
            image/*) filename=${file#* } ; image+="${filename}:" ;;
            video/*) filename=${file#* } ; video+="${filename}:" ;;
            audio/*) filename=${file#* } ; audio+="${filename}:" ;;
            *) filename=${file#* } ; other+="${filename}:" ;;
        esac
    done

    IFS=':'
    [ -z "$text" ] || $EDITOR -- $text
    [ -z "$image" ] || setsid mpv --keep-open=yes -- $image & disown
    [ -z "$video" ] || setsid mpv -- $video & disown
    [ -z "$audio" ] || setsid mpv --force-window=yes -- $audio & disown
    [ -z "$other" ] || xdg-open $other

    lf -remote "send $id unselect"
    lf -remote "send $id redraw"
}}
map l open

set filesep ':'
cmd rename ${{
    IFS=':'
    massren $fx
    lf -remote "send $id unselect"
}}
map r rename

cmd mkdir %{{
    if [ -n "$1" ]; then
        ans="$1"
    else
        printf "Directory name: "
        read ans
    fi
    mkdir "$ans"
}}

cmd touch %{{
    if [ -n "$1" ]; then
        ans="$1"
    else
        printf "File name: "
        read ans
    fi
    touch "$ans"
}}

cmd chmod %{{
    if [ -n "$1" ]; then
        ans="$1"
    else
        printf "Mode Bits: "
        read ans
    fi

    for file in "$fx"
    do
        chmod $ans $file
    done

    lf -remote 'send reload'
}}

